# Copy this file to ".env" and fill in your own values. ".env" is git-ignored.
# Everything here is optional - the app works without a .env file.

# TMDB "API Read Access Token" (https://www.themoviedb.org/settings/api).
# Only needed for images of actors that are not in the bundled image cache.
TMDB_TOKEN=

# Port for the web server (default 8080).
# PORT=8080

# Use a local data file instead of downloading the full dataset.
# DATA_FILE=C:/path/to/moviedata.txt.gz

# Set to "demo" to always start with the small bundled dataset.
# DATASET=demo
